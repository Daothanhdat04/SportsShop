@model SportsShop.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout"; // vẫn dùng layout chung
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="login-page d-flex justify-content-center align-items-center">
    <div class="login-card card shadow-lg border-0">
        <div class="card-header text-center text-white py-4">
            <h3><i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập</h3>
        </div>

        <div class="card-body p-4">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email của bạn..." />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-login-form">
                        <i class="fa-solid fa-unlock"></i> Đăng nhập
                    </button>
                </div>
            </form>

            <hr />

            <div class="text-center">
                <p>
                    Chưa có tài khoản?
                    <a asp-action="Register" class="text-primary fw-semibold">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
