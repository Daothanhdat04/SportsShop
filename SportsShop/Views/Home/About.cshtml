@{
    ViewData["Title"] = "Về chúng tôi";
}
<link rel="stylesheet" href="~/css/about.css" />

<!-- About Page -->
<div class="about-page">
    <!-- Hero Section -->
    <section class="about-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <h1 class="hero-title">
                            <i class="fa-solid fa-basketball"></i>
                            Về SportsShop
                        </h1>
                        <p class="hero-subtitle">
                            Đồng hành cùng đam mê thể thao của bạn
                        </p>
                        <p class="hero-description">
                            Chúng tôi là đơn vị hàng đầu trong lĩnh vực cung cấp các sản phẩm
                            thể thao chất lượng cao với giá cả hợp lý. Với hơn 10 năm kinh nghiệm,
                            SportsShop cam kết mang đến trải nghiệm mua sắm tốt nhất cho khách hàng.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image">
                        <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=800"
                             alt="Sports Equipment" class="img-fluid rounded-4 shadow-lg">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Values -->
    <section class="about-values">
        <div class="container">
            <div class="section-header text-center mb-5">
                <h2 class="section-title">Giá Trị Cốt Lõi</h2>
                <p class="section-subtitle">Những gì chúng tôi mang đến cho bạn</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <h3 class="value-title">Chất Lượng</h3>
                        <p class="value-text">
                            100% sản phẩm chính hãng, được kiểm tra kỹ lưỡng trước khi giao hàng.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <h3 class="value-title">Giao Hàng Nhanh</h3>
                        <p class="value-text">
                            Vận chuyển nhanh chóng, đảm bảo sản phẩm đến tay bạn an toàn.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <h3 class="value-title">Hỗ Trợ 24/7</h3>
                        <p class="value-text">
                            Đội ngũ tư vấn chuyên nghiệp, sẵn sàng hỗ trợ mọi lúc mọi nơi.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa-solid fa-rotate-left"></i>
                        </div>
                        <h3 class="value-title">Đổi Trả Dễ Dàng</h3>
                        <p class="value-text">
                            Chính sách đổi trả linh hoạt trong vòng 30 ngày không cần lý do.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics -->
    <section class="about-stats">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h3 class="stat-number">50,000+</h3>
                        <p class="stat-label">Khách Hàng Tin Dùng</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <h3 class="stat-number">10,000+</h3>
                        <p class="stat-label">Sản Phẩm Đa Dạng</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-store"></i>
                        </div>
                        <h3 class="stat-number">15+</h3>
                        <p class="stat-label">Chi Nhánh Toàn Quốc</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <h3 class="stat-number">4.8/5</h3>
                        <p class="stat-label">Đánh Giá Trung Bình</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact CTA -->
    <section class="about-cta">
        <div class="container">
            <div class="cta-box">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2 class="cta-title">Bạn Có Câu Hỏi?</h2>
                        <p class="cta-text">
                            Đội ngũ của chúng tôi luôn sẵn sàng giải đáp mọi thắc mắc của bạn.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="tel:0123456789" class="btn btn-cta">
                            <i class="fa-solid fa-phone"></i> Liên Hệ Ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>