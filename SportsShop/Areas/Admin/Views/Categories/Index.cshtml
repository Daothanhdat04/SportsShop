@model IEnumerable<SportsShop.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<link rel="stylesheet" href="~/css/admin-categories.css" />

<div class="d-flex justify-content-between align-items-center mb-4 categories-page-header">
    <h2><i class="fas fa-list"></i> Quản lý danh mục</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Thêm danh mục
    </a>
</div>

<div class="card shadow categories-table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover categories-table">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Số sản phẩm</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.Description</td>
                            <td>
                                <span class="badge bg-info">@(item.Products?.Count ?? 0) sản phẩm</span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3 categories-stats">
            <p class="text-muted">Tổng số danh mục: <strong>@Model.Count()</strong></p>
        </div>
    </div>
</div>