@model SportsShop.Models.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
}

<h2 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Xóa đơn hàng</h2>
<hr />

<div class="alert alert-danger">
    <h4>Bạn có chắc chắn muốn xóa đơn hàng này?</h4>
    <p>Hành động này không thể hoàn tác!</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã đơn hàng:</dt>
            <dd class="col-sm-9"><strong>#@Model.Id</strong></dd>

            <dt class="col-sm-3">Khách hàng:</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@Model.CustomerEmail</dd>

            <dt class="col-sm-3">Số điện thoại:</dt>
            <dd class="col-sm-9">@Model.CustomerPhone</dd>

            <dt class="col-sm-3">Ngày đặt:</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Tổng tiền:</dt>
            <dd class="col-sm-9"><strong>@Model.TotalAmount.ToString("N0") ₫</strong></dd>

            <dt class="col-sm-3">Trạng thái:</dt>
            <dd class="col-sm-9">
                <span class="badge bg-warning">@Model.Status</span>
            </dd>

            <dt class="col-sm-3">Số sản phẩm:</dt>
            <dd class="col-sm-9">@Model.OrderDetails.Sum(od => od.Quantity)</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Xác nhận xóa
            </button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>