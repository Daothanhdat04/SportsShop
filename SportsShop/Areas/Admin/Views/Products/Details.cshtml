@model SportsShop.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-box"></i> Chi tiết sản phẩm</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 300px; object-fit: cover;">
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Thông tin sản phẩm</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID:</dt>
                    <dd class="col-sm-9">@Model.Id</dd>

                    <dt class="col-sm-3">Tên:</dt>
                    <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                    <dt class="col-sm-3">Mô tả:</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Giá:</dt>
                    <dd class="col-sm-9"><strong class="text-danger fs-5">@Model.Price.ToString("N0") ₫</strong></dd>

                    <dt class="col-sm-3">Tồn kho:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Stock < 10)
                        {
                            <span class="badge bg-warning">@Model.Stock (Sắp hết!)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Stock</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Danh mục:</dt>
                    <dd class="col-sm-9">@Model.Category?.Name</dd>

                    <dt class="col-sm-3">Size/Màu:</dt>
                    <dd class="col-sm-9">
                        @if (Model.HasVariants)
                        {
                            <span class="badge bg-info">Có</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (Model.HasVariants && Model.Variants != null && Model.Variants.Any())
        {
            <div class="card mt-3">
                <div class="card-header bg-info text-white">
                    <h5>Biến thể sản phẩm (Size & Màu)</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Màu</th>
                                <th>Size</th>
                                <th>Tồn kho</th>
                                <th>SKU</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in Model.Variants)
                            {
                                <tr>
                                    <td>@variant.Color</td>
                                    <td>@variant.Size</td>
                                    <td>
                                        @if (variant.Stock > 0)
                                        {
                                            <span class="badge bg-success">@variant.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                    <td>@variant.SKU</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>