@model SportsShop.Models.Product

@{
    ViewData["Title"] = "Quản lý biến thể";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-palette"></i> Quản lý biến thể: @Model.Name</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5><i class="fas fa-plus"></i> Thêm biến thể mới</h5>
            </div>
           
            <div class="card-body">
<form asp-action="AddVariant" method="post" onsubmit="return validateVariantForm()">
    <input type="hidden" name="productId" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Màu sắc <span class="text-danger">*</span></label>
        <input type="text" name="color" class="form-control" placeholder="VD: Đỏ, Xanh, Đen..." required />
    </div>

    <div class="mb-3">
        <label class="form-label">Size <span class="form-label">*</span></label>
        <input type="text" name="size" class="form-control" placeholder="VD: S, M, L, XL..." required />
    </div>

    <div class="mb-3">
        <label class="form-label">Tồn kho <span class="text-danger">*</span></label>
        <input type="number" name="stock" class="form-control" min="0" required />
    </div>

    <hr />
    <div class="alert alert-info">
        <strong>💰 Giá gốc sản phẩm:</strong> @Model.Price.ToString("N0") ₫
        @if (Model.IsOnDiscount)
        {
            <br />
            <strong>🔥 Giá giảm chung:</strong> @Model.DiscountPrice.Value.ToString("N0")
            <span class="badge bg-danger">-@Model.DiscountPercent%</span>
        }
    </div>
    
    <h6>Giảm giá riêng cho biến thể này (tùy chọn)</h6>
    <small class="text-muted">Để trống nếu dùng giá giảm chung của sản phẩm</small>
    
  <div class="mb-3 mt-2">
    <label class="form-label">% Giảm giá riêng</label>
   
    
    <div class="input-group">
        <input type="number" 
               name="discountPercent" 
               class="form-control" 
               min="0" 
               max="100" 
               id="variantDiscountPercent" 
               onchange="calculateVariantDiscount()"
               onkeyup="calculateVariantDiscount()"
               placeholder="Hoặc nhập % tùy chỉnh" />
        <span class="input-group-text">%</span>
    </div>
    <small class="text-muted">Chọn nhanh hoặc nhập % tùy chỉnh</small>
</div>

    <div class="mb-3">
        <label class="form-label">Giá sau giảm (tự động)</label>
        <div class="input-group">
            <input type="number" 
                   name="discountPrice" 
                   class="form-control bg-light" 
                   id="variantDiscountPrice" 
                   readonly 
                   placeholder="Tự động tính" />
            <span class="input-group-text">₫</span>
        </div>
        <small class="text-success" id="savingAmount" style="display: none;">
            💵 Tiết kiệm: <strong id="savingValue"></strong>
        </small>
    </div>

    <button type="submit" class="btn btn-primary w-100">
        <i class="fas fa-save"></i> Thêm biến thể
    </button>
</form>
</div>

        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5><i class="fas fa-list"></i> Danh sách biến thể (@(Model.Variants?.Count ?? 0))</h5>
            </div>
            <div class="card-body">
                @if (Model.Variants == null || !Model.Variants.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Chưa có biến thể nào. Hãy thêm biến thể ở bên trái.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                           <thead class="table-light">
    <tr>
        <th>Màu</th>
        <th>Size</th>
        <th>Giá</th>
        <th>Tồn kho</th>
        <th>SKU</th>
        <th>Thao tác</th>
    </tr>
</thead>
<tbody>
    @foreach (var variant in Model.Variants.OrderBy(v => v.Color).ThenBy(v => v.Size))
    {
        <tr>
            <td><strong>@variant.Color</strong></td>
            <td>@variant.Size</td>
            <td>
                @if (variant.HasDiscount)
                {
                    <span class="text-decoration-line-through text-muted">@Model.Price.ToString("N0") ₫</span><br />
                    <strong class="text-danger">@variant.DiscountPrice.Value.ToString("N0") ₫</strong>
                    <span class="badge bg-danger">-@variant.DiscountPercent%</span>
                }
                else if (Model.IsOnDiscount)
                {
                    <span class="text-decoration-line-through text-muted">@Model.Price.ToString("N0") ₫</span><br />
                    <strong class="text-danger">@Model.DiscountPrice.Value.ToString("N0") ₫</strong>
                    <span class="badge bg-warning">Giảm chung</span>
                }
                else
                {
                    <strong>@Model.Price.ToString("N0") ₫</strong>
                }
            </td>
            <td>
                @if (variant.Stock > 0)
                {
                    <span class="badge bg-success">@variant.Stock</span>
                }
                else
                {
                    <span class="badge bg-danger">Hết hàng</span>
                }
            </td>
            <td><code>@variant.SKU</code></td>
            <td>
                <form asp-action="DeleteVariant" method="post" class="d-inline" onsubmit="return confirm('Xóa biến thể này?')">
                    <input type="hidden" name="id" value="@variant.Id" />
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </td>
        </tr>
    }

</tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <p class="text-muted">
                            <strong>Tổng số biến thể:</strong> @Model.Variants.Count<br />
                            <strong>Tổng tồn kho:</strong> @Model.Variants.Sum(v => v.Stock)
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // ---- 1️⃣ Lấy giá gốc sản phẩm (an toàn, tránh lỗi dấu phẩy hoặc null) ----
        const productPrice = parseFloat('@Model.Price'.replace(',', '.')) || 0;

       function calculateVariantDiscount() {
            const discountPercent = parseFloat(document.getElementById('variantDiscountPercent').value) || 0;
            const discountPriceInput = document.getElementById('variantDiscountPrice');
            const savingAmount = document.getElementById('savingAmount');
            const savingValue = document.getElementById('savingValue');
            
            if (discountPercent > 0 && discountPercent <= 100) {
                // Tính giá sau giảm
                const discountPrice = Math.round(productPrice - (productPrice * discountPercent / 100));
                discountPriceInput.value = discountPrice;
                
                // Hiển thị số tiền tiết kiệm
                const saving = productPrice - discountPrice;
                savingValue.textContent = saving.toLocaleString('vi-VN') + ' ₫';
                savingAmount.style.display = 'block';
                
                // Đổi màu input
                discountPriceInput.classList.remove('bg-light');
                discountPriceInput.classList.add('bg-success', 'text-white', 'fw-bold');
            } else {
                // Xóa giá giảm nếu không nhập %
                discountPriceInput.value = '';
                discountPriceInput.classList.remove('bg-success', 'text-white', 'fw-bold');
                discountPriceInput.classList.add('bg-light');
                savingAmount.style.display = 'none';
            }
        }
        
        // Reset form sau khi submit thành công
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            // Reset form
            document.querySelector('input[name="color"]').value = '';
            document.querySelector('input[name="size"]').value = '';
            document.querySelector('input[name="stock"]').value = '';
            document.getElementById('variantDiscountPercent').value = '';
            document.getElementById('variantDiscountPrice').value = '';
            document.getElementById('savingAmount').style.display = 'none';
            </text>
        }
        function validateVariantForm() {
    const discountPercent = parseFloat(document.getElementById('variantDiscountPercent').value) || 0;
    const discountPrice = parseFloat(document.getElementById('variantDiscountPrice').value) || 0;
    
    // Nếu có nhập % nhưng giá chưa tính
    if (discountPercent > 0 && discountPrice === 0) {
        alert('Vui lòng kiểm tra lại giá giảm!');
        return false;
    }
    
    // Nếu giá giảm >= giá gốc (sai logic)
    if (discountPrice > 0 && discountPrice >= productPrice) {
        alert('Giá giảm phải nhỏ hơn giá gốc!');
        return false;
    }
    
    return true;
}
    </script>
}
